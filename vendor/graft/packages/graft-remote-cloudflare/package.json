{
  "name": "@eidos.space/graft-remote-cloudflare",
  "version": "0.1.0",
  "description": "Cloudflare storage and authentication adapters for @eidos.space/graft-remote",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eidos-space/graft.git",
    "directory": "packages/graft-remote-cloudflare"
  },
  "homepage": "https://github.com/eidos-space/graft",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@eidos.space/graft-remote": "workspace:^"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260722.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
