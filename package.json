{
  "name": "eidos",
  "private": true,
  "type": "module",
  "description": "Open Eidos File tooling and the local-first Eidos Lite desktop app.",
  "author": "mayneyao",
  "scripts": {
    "dev": "pnpm run dev:eidos-lite",
    "dev:eidos-file-web": "pnpm run --filter @eidos.space/eidos-file-web dev",
    "dev:eidos-lite": "pnpm run --filter @eidos.space/eidos-lite-desktop dev",
    "dev:markdown-editor-playground": "pnpm run --filter @eidos.space/markdown-editor-playground dev",
    "dev:sqlite-web-viewer": "pnpm run --filter @eidos.space/sqlite-web-viewer dev",
    "dev:docs": "pnpm run --filter docs dev",
    "build": "pnpm run build:markdown-editor && pnpm run build:eidos-file-ui && pnpm run build:eidos-file-web && pnpm run build:eidos-lite && pnpm run build:sqlite-web-viewer",
    "build:eidos-file": "pnpm run --filter @eidos.space/eidos-file build",
    "build:eidos-file-web": "pnpm run --filter @eidos.space/eidos-file-web build",
    "build:eidos-file-ui": "pnpm run --filter @eidos.space/eidos-file-ui build",
    "build:markdown-editor": "pnpm run --filter @eidos.space/markdown-editor build",
    "build:markdown-editor-playground": "pnpm run --filter @eidos.space/markdown-editor-playground build",
    "build:eidos-lite": "pnpm run --filter @eidos.space/eidos-lite-desktop build",
    "build:eidos-lite:production": "pnpm run --filter @eidos.space/eidos-lite-desktop build:production",
    "build:eidos-lite:release": "pnpm run --filter @eidos.space/eidos-lite-desktop package:release",
    "build:eidos-lite:release:linux": "pnpm run --filter @eidos.space/eidos-lite-desktop package:release:linux",
    "build:eidos-lite:dev": "pnpm run --filter @eidos.space/eidos-lite-desktop build && pnpm run --filter @eidos.space/eidos-lite-desktop package:dir",
    "build:sqlite-web-viewer": "pnpm run --filter @eidos.space/sqlite-web-viewer build",
    "deploy:eidos-file-web": "pnpm run --filter @eidos.space/eidos-file-web deploy",
    "deploy:markdown-editor-playground": "pnpm run --filter @eidos.space/markdown-editor-playground deploy",
    "build:docs": "pnpm run --filter docs build",
    "deploy:docs": "pnpm run --filter docs deploy",
    "build:cli": "cd apps/cli && cargo build --release",
    "build:cli:dev": "cd apps/cli && cargo build",
    "smoke:cli-graft": "node apps/cli/graft-versioning-smoke.mjs",
    "smoke:eidos-lite-graft": "pnpm run --filter @eidos.space/eidos-lite-desktop test:graft",
    "smoke:eidos-lite-services": "pnpm run --filter @eidos.space/eidos-lite-desktop test:service-discovery",
    "smoke:eidos-lite-staging": "pnpm run --filter @eidos.space/eidos-lite-desktop test:staging:oauth",
    "smoke:eidos-lite-packaged": "pnpm run --filter @eidos.space/eidos-lite-desktop smoke:packaged",
    "test:eidos-lite": "pnpm run --filter @eidos.space/eidos-lite-desktop test",
    "test:markdown-editor": "pnpm run --filter @eidos.space/markdown-editor test",
    "test:markdown-editor-playground": "pnpm run --filter @eidos.space/markdown-editor-playground test",
    "test:eidos-lite:performance": "pnpm run --filter @eidos.space/eidos-lite-desktop test:performance",
    "test:eidos-lite:performance:large": "pnpm run --filter @eidos.space/eidos-lite-desktop test:performance:large",
    "test:eidos-file": "pnpm run --filter @eidos.space/eidos-file test && pnpm run --filter @eidos.space/eidos-file-ui test && pnpm run --filter @eidos.space/eidos-file-serve test && pnpm run --filter @eidos.space/eidos-file-web test",
    "test:sqlite-web-viewer": "pnpm run --filter @eidos.space/sqlite-web-viewer test",
    "test:cli-release": "node --test apps/cli/install.test.mjs apps/cli/release.test.mjs apps/download/src/release-routing.test.mjs",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck:ts": "pnpm run --recursive typecheck",
    "typecheck": "pnpm run --recursive typecheck:tsgo",
    "format:write": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "pnpm run test:markdown-editor && pnpm run test:markdown-editor-playground && pnpm run test:eidos-file && pnpm run test:eidos-lite && pnpm run test:sqlite-web-viewer && cd apps/cli && cargo test --workspace --locked",
    "knip": "knip",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,json,md}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "devDependencies": {
    "@types/node": "^20.19.1",
    "@typescript/native-preview": "7.0.0-dev.20260407.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.3",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.3.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.0.0+sha512.9e2e3dc3911995868dc94b8175c217c27e95408fa03b4a22749778f2b34f773b77cdd3b39ede8171b22fcd53be6a35342e9fac9948a68ef58df6488ce89a7e67"
}
