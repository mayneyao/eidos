{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "skipLibCheck": true,
    "allowJs": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    /* Linting */
    "strict": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@eidos.space/core": ["./packages/core/index.ts"],
      "@eidos.space/core/*": ["./packages/core/*"],
      "@eidos.space/client": ["./packages/client/src/index.ts"],
      "@eidos.space/client/*": ["./packages/client/src/*"],
      "@eidos.space/react": ["./packages/react/src/index.ts"],
      "@eidos.space/react/*": ["./packages/react/src/*"],
      "@eidos.space/v3": ["./packages/v3/src/index.ts"],
      "@eidos.space/v3/*": ["./packages/v3/src/*"],
      "@eidos.space/space-manager": ["./packages/space-manager/src/index.ts"],
      "@eidos.space/space-manager/*": ["./packages/space-manager/src/*"],
      "@eidos.space/file-space": ["./packages/file-space/src/index.ts"],
      "@eidos.space/file-space/*": ["./packages/file-space/src/*"],
      "@eidos.space/base": ["./packages/base/src/index.ts"],
      "@eidos.space/base/*": ["./packages/base/src/*"],
      "@eidos.space/legacy-space-migration": [
        "./packages/legacy-space-migration/src/index.ts"
      ],
      "@eidos.space/legacy-space-migration/*": [
        "./packages/legacy-space-migration/src/*"
      ],
      "@eidos.space/graft-client": ["./packages/graft-client/src/index.ts"],
      "@eidos.space/graft-client/*": ["./packages/graft-client/src/*"],
      "@eidos.space/markdown-editor": [
        "./packages/markdown-editor/src/index.ts"
      ],
      "@eidos.space/markdown-editor/*": ["./packages/markdown-editor/src/*"],
      "@eidos.space/proxy": ["./packages/proxy/src/index.ts"],
      "@eidos.space/proxy/*": ["./packages/proxy/src/*"],
      "@eidos.space/sync": ["./packages/sync/index.ts"],
      "@eidos.space/sync/*": ["./packages/sync/*"],
      "@eidos.space/ext-server": ["./packages/ext-server/src/index.ts"],
      "@eidos.space/ext-server/*": ["./packages/ext-server/src/*"],
      "@eidos.space/rawdata": ["./packages/rawdata/src/index.ts"],
      "@eidos.space/rawdata/*": ["./packages/rawdata/src/*"],
      "@eidos.space/electron-ipc": ["./packages/electron-ipc/src/index.ts"],
      "@eidos.space/electron-ipc/*": ["./packages/electron-ipc/src/*"],
      "@eidos.space/extension-manifest": [
        "./packages/extension-manifest/src/index.ts"
      ],
      "@eidos.space/extension-manifest/*": [
        "./packages/extension-manifest/src/*"
      ],
      "@eidos.space/extension-runtime": [
        "./packages/extension-runtime/src/index.ts"
      ],
      "@eidos.space/extension-runtime/*": [
        "./packages/extension-runtime/src/*"
      ],
      "@eidos.space/extension-sdk": ["./packages/extension-sdk/src/index.ts"],
      "@eidos.space/extension-sdk/*": ["./packages/extension-sdk/src/*"],
      "@eidos.space/extension-state": [
        "./packages/extension-state/src/index.ts"
      ],
      "@eidos.space/extension-state/*": ["./packages/extension-state/src/*"],
      "@/locales/*": ["./packages/locales/*"],
      "@/worker/*": ["./packages/worker/*"],
      "@/lib/*": ["./packages/lib/*"],
      "@/components/*": ["./apps/web-app/components/*"],
      "@/hooks/*": ["./apps/web-app/hooks/*"],
      "@/styles/*": ["./apps/web-app/styles/*"],
      "@/*": ["./*"]
    },
    "types": [
      "vite-plugin-pwa/react",
      "node",
      "vitest/globals",
      "vite/client",
      "@types/wicg-file-system-access"
    ]
  },
  "include": ["**/*.wasm", "packages/shared/types/**/*.d.ts"],
  "exclude": [
    ".wrangler",
    "node_modules",
    "dist",
    "dev-dist",
    "dist-electron",
    "public",
    "**/node_modules/**",
    "**/dist/**",
    "**/dev-dist/**",
    "**/dist-electron/**"
  ]
}
