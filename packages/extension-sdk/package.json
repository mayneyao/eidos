{
  "name": "@eidos.space/extension-sdk",
  "version": "0.1.0",
  "description": "Capability-oriented SDK types for Eidos file-based extensions",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "typecheck:tsgo": "tsgo --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "eidos",
    "extension",
    "sdk"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.19.1",
    "tsdown": "^0.21.7",
    "typescript": "^5.8.3"
  }
}
