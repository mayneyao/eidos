{
  "name": "@eidos.space/sandbox",
  "version": "1.0.0",
  "description": "Script sandbox for Eidos",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsdown src/binary-data.ts -d src/ --dts false --no-clean",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": "./dist/index.js",
      "./*": "./dist/*.js"
    }
  },
  "keywords": [
    "eidos.space",
    "sandbox"
  ],
  "author": "mayneyao",
  "license": "ISC",
  "packageManager": "pnpm@10.12.4"
}