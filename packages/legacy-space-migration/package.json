{
  "name": "@eidos.space/legacy-space-migration",
  "version": "0.1.0",
  "description": "Read-only planning and export runtime for migrating legacy Eidos Spaces",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./better-sqlite3": {
      "types": "./dist/better-sqlite3.d.mts",
      "import": "./dist/better-sqlite3.mjs",
      "default": "./dist/better-sqlite3.mjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:tsgo": "tsgo --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "eidos.space",
    "migration",
    "sqlite",
    "markdown"
  ],
  "author": "mayneyao",
  "license": "AGPL-3.0",
  "dependencies": {
    "@eidos.space/eidos-file": "workspace:*",
    "@eidos.space/extension-manifest": "workspace:*",
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "better-sqlite3": ">=11.0.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.4.1",
    "better-sqlite3": "^12.0.0",
    "tsdown": "^0.21.7",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
