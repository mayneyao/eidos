{
  "name": "@eidos.space/proxy",
  "version": "1.0.0",
  "description": "HTTP Proxy service for Eidos - subdomain-based cross-origin request proxying",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:tsgo": "tsgo --noEmit"
  },
  "type": "module",
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": "./dist/index.js",
      "./*": "./dist/*.js"
    }
  },
  "dependencies": {
    "hono": "^4.12.7"
  },
  "devDependencies": {
    "vitest": "^3.0.0"
  },
  "keywords": [
    "eidos.space",
    "proxy",
    "cors",
    "http-proxy"
  ],
  "author": "mayneyao",
  "license": "ISC",
  "packageManager": "pnpm@10.12.4"
}
