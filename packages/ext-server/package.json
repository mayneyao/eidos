{
  "name": "@eidos.space/ext-server",
  "version": "0.1.0",
  "description": "Hono middleware for rendering Eidos block extensions server-side",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./eidos": "./dist/eidos.js",
    "./desktop": "./dist/desktop.js"
  },
  "scripts": {
    "build:assets": "node scripts/build-assets.mjs",
    "prepare": "pnpm run build:assets",
    "build": "pnpm run build:assets && tsdown src/index.ts src/eidos.ts src/desktop.ts --format esm --dts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.12.7"
  },
  "peerDependencies": {
    "tailwindcss": "^3.0.0 || ^4.0.0"
  },
  "devDependencies": {
    "@eidos.space/v3": "workspace:*",
    "@types/node": "^20.17.12",
    "tailwindcss": "^4.0.0",
    "tsdown": "^0.9.1",
    "typescript": "^5.7.3"
  },
  "keywords": [
    "hono",
    "middleware",
    "extension",
    "eidos"
  ],
  "license": "MIT"
}
