{
  "name": "@eidos.space/eidos-file",
  "version": "1.0.0",
  "description": "Independent SQLite-backed runtime for the open Eidos File format",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./better-sqlite3": {
      "types": "./dist/better-sqlite3.d.mts",
      "import": "./dist/better-sqlite3.mjs",
      "default": "./dist/better-sqlite3.mjs"
    },
    "./node-sqlite": {
      "types": "./dist/node-sqlite.d.mts",
      "import": "./dist/node-sqlite.mjs",
      "default": "./dist/node-sqlite.mjs"
    },
    "./browser": {
      "types": "./dist/browser.d.mts",
      "browser": "./dist/browser.mjs",
      "import": "./dist/browser.mjs",
      "default": "./dist/browser.mjs"
    },
    "./csv": {
      "types": "./dist/csv.d.mts",
      "import": "./dist/csv.mjs",
      "default": "./dist/csv.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "FIELD-CONVERSION.md",
    "DEVELOPER_PLATFORM.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "build:quickjs": "esbuild src/quickjs-entry.ts --bundle --format=iife --target=es2020 --alias:vitest=./src/quickjs/expect-shim.ts --outfile=../../apps/cli/qjs-host/bundle/eidos-runtime.js --minify",
    "api:report": "api-extractor run --local && api-extractor run --local --config api-extractor.browser.json",
    "api:check": "api-extractor run && api-extractor run --config api-extractor.browser.json",
    "test": "vitest run --config vitest.config.ts",
    "test:node-sqlite": "node ../../scripts/run-electron-node.mjs ../../node_modules/vitest/vitest.mjs run --config vitest.node-sqlite.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:public": "tsc -p test-d/tsconfig.json",
    "typecheck:tsgo": "tsgo --noEmit",
    "prepublishOnly": "pnpm run build && pnpm run typecheck:public && pnpm run api:check"
  },
  "keywords": [
    "eidos.space",
    "eidos-file",
    "multidimensional-table",
    "sqlite",
    "local-first"
  ],
  "author": "mayneyao",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mayneyao/eidos.git",
    "directory": "packages/eidos-file"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "better-sqlite3": ">=11.0.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    }
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.45.3-build2",
    "csv-parse": "^5.6.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.58.11",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.12.2",
    "better-sqlite3": "^12.0.0",
    "tsdown": "^0.21.7",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
