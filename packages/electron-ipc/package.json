{
  "name": "@eidos.space/electron-ipc",
  "version": "0.1.0",
  "description": "Decorator-based IPC framework for Electron with automatic method discovery",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "electron",
    "ipc",
    "decorator",
    "typescript",
    "eidos"
  ],
  "author": "mayneyao",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mayneyao/eidos.git",
    "directory": "packages/electron-ipc"
  },
  "bugs": {
    "url": "https://github.com/mayneyao/eidos/issues"
  },
  "homepage": "https://github.com/mayneyao/eidos/tree/main/packages/electron-ipc#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "electron": ">=32.0.0"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "tsdown": "^0.21.7",
    "typescript": "^5.8.0"
  }
}
