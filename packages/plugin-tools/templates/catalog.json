{
  "theme": {
    "description": "Standalone Eidos Lite host theme with light and dark palettes",
    "manifest": {
      "kind": "theme",
      "requires": {
        "pluginApi": "1.6.0"
      },
      "theme": {
        "stylesheet": "./theme.css"
      }
    },
    "files": {
      "theme.css": "theme.css.txt"
    }
  },
  "document-view": {
    "description": "CSV file editor with host save and undo/redo",
    "manifest": {
      "requires": {
        "pluginApi": "3.0.0"
      },
      "views": [
        {
          "id": "table",
          "title": "CSV Table",
          "entry": "./src/main.ts",
          "access": "write",
          "kind": "file",
          "capabilities": ["document"]
        }
      ],
      "placements": [
        {
          "location": "file/open",
          "view": "table",
          "extensions": [".csv"]
        }
      ]
    },
    "files": {
      "src/main.ts": "main.ts.txt",
      "src/csv.ts": "csv.ts.txt",
      "src/style.css": "style.css.txt"
    }
  },
  "eidos-view": {
    "description": "Browse tables and fields in an .eidos file",
    "manifest": {
      "requires": {
        "pluginApi": "3.0.0"
      },
      "views": [
        {
          "id": "main",
          "title": "File overview",
          "entry": "./src/main.ts",
          "access": "read",
          "kind": "file",
          "capabilities": ["eidos/schema"]
        }
      ],
      "placements": [
        {
          "location": "file/open",
          "extensions": [".eidos"],
          "view": "main"
        }
      ]
    },
    "files": {
      "src/main.ts": "eidos-view.ts.txt",
      "src/style.css": "base.css.txt"
    }
  },
  "table-view": {
    "description": "Table record count with live invalidation for Lite and CLI Serve",
    "manifest": {
      "requires": {
        "pluginApi": "3.0.0"
      },
      "views": [
        {
          "id": "main",
          "title": "Record count",
          "entry": "./src/main.ts",
          "access": "read",
          "kind": "file",
          "capabilities": ["eidos/table"]
        }
      ],
      "placements": [
        {
          "location": "table/view",
          "view": "main"
        }
      ]
    },
    "files": {
      "src/main.ts": "table-view.ts.txt",
      "src/style.css": "base.css.txt"
    }
  },
  "table-action": {
    "description": "Set a checkbox on target records, with progress and host undo",
    "manifest": {
      "requires": {
        "pluginApi": "3.0.0"
      },
      "extension": "./src/extension.ts",
      "actions": [
        {
          "id": "complete",
          "title": "Mark complete",
          "context": "table",
          "access": "write"
        }
      ],
      "placements": [
        {
          "location": "table/context",
          "action": "complete"
        }
      ]
    },
    "files": {
      "src/extension.ts": "table-action.ts.txt",
      "tests/action.test.mjs": "action.test.mjs.txt"
    },
    "scripts": {
      "test": "node --experimental-strip-types --test tests/*.test.mjs"
    }
  },
  "page": {
    "description": "Independent page opened by a navigation entry or command",
    "manifest": {
      "requires": {
        "pluginApi": "3.0.0"
      },
      "views": [
        {
          "id": "main",
          "title": "Hello page",
          "entry": "./src/main.ts",
          "kind": "page"
        }
      ],
      "placements": [
        {
          "location": "navigation",
          "view": "main"
        },
        {
          "location": "command-palette",
          "action": "open"
        }
      ],
      "extension": "./src/extension.ts",
      "actions": [
        {
          "id": "open",
          "title": "Open hello page",
          "context": "workspace"
        }
      ]
    },
    "files": {
      "src/main.ts": "page.ts.txt",
      "src/extension.ts": "page-extension.ts.txt",
      "src/style.css": "base.css.txt"
    }
  }
}
