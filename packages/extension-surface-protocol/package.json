{
  "name": "@eidos.space/extension-surface-protocol",
  "version": "0.1.0",
  "description": "Versioned document and MessagePort protocol for sandboxed Eidos extension surfaces",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:tsgo": "tsgo --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "eidos",
    "extension",
    "surface",
    "document",
    "protocol"
  ],
  "author": "mayneyao",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mayneyao/eidos.git",
    "directory": "packages/extension-surface-protocol"
  },
  "homepage": "https://github.com/mayneyao/eidos/tree/main/packages/extension-surface-protocol#readme",
  "bugs": {
    "url": "https://github.com/mayneyao/eidos/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@types/node": "^20.19.1",
    "tsdown": "^0.21.7",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
