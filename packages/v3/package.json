{
  "name": "@eidos.space/v3",
  "version": "1.0.0",
  "description": "Code compilation and analysis tools for Eidos",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "typecheck": "tsc --noEmit",
    "typecheck:tsgo": "tsgo --noEmit"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": "./dist/index.js",
      "./*": "./dist/*.js"
    }
  },
  "keywords": [
    "eidos.space",
    "compiler",
    "code-tools"
  ],
  "author": "mayneyao",
  "license": "ISC",
  "packageManager": "pnpm@10.12.4",
  "devDependencies": {
    "@types/node": "^20.4.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@oxc-parser/binding-wasm32-wasi": "^0.75.0",
    "@oxc-transform/binding-wasm32-wasi": "^0.75.0",
    "diff": "^8.0.2",
    "oxc-parser": "^0.74.0",
    "oxc-transform": "^0.74.0"
  }
}
