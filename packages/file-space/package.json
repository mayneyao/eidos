{
  "name": "@eidos.space/file-space",
  "version": "0.1.0",
  "description": "Independent file-based Space runtime for Eidos",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js",
      "default": "./dist/markdown.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --config vitest.config.ts",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "typecheck:tsgo": "tsgo --noEmit"
  },
  "type": "module",
  "keywords": [
    "eidos.space",
    "file-space",
    "local-first"
  ],
  "author": "mayneyao",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.4.1",
    "tsdown": "^0.12.9",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
