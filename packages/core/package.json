{
  "name": "@eidos.space/core",
  "version": "0.28.4",
  "description": "core package for eidos.space",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "readme.md"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "echo \"Error: no test specified\" && exit 1",
    "typecheck": "tsc --noEmit",
    "typecheck:tsgo": "tsgo --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "type": "module",
  "keywords": [
    "eidos",
    "eidos.space",
    "core",
    "sdk",
    "database",
    "sqlite",
    "personal-data-management"
  ],
  "author": "mayneyao",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mayneyao/eidos.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/mayneyao/eidos/issues"
  },
  "homepage": "https://github.com/mayneyao/eidos/tree/main/packages/core#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.2",
    "lodash": "^4.17.21",
    "pgsql-ast-parser": "^11.2.0",
    "postal-mime": "^2.4.4",
    "sql-formatter": "^15.6.5",
    "uuid": "^11.1.0",
    "uuidv7": "^1.0.2",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@glideapps/glide-data-grid": "^6.0.3",
    "@types/lodash": "^4.14.195",
    "@types/node": "^20.4.1",
    "@types/uuid": "^9.0.2",
    "tsdown": "^0.12.9",
    "typescript": "^5.8.3"
  }
}
