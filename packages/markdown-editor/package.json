{
  "name": "@eidos.space/markdown-editor",
  "version": "0.1.0",
  "description": "Standalone Lexical Markdown editor and viewer for Eidos",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src/styles.css",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "./src/styles.css"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:tsgo": "tsgo --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "eidos.space",
    "lexical",
    "markdown",
    "editor"
  ],
  "author": "mayneyao",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mayneyao/eidos.git",
    "directory": "packages/markdown-editor"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": "^0.52.0",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@lexical/code": "0.47.0",
    "@lexical/code-prism": "0.47.0",
    "@lexical/extension": "0.47.0",
    "@lexical/link": "0.47.0",
    "@lexical/list": "0.47.0",
    "@lexical/mdast": "0.47.0",
    "@lexical/react": "0.47.0",
    "@lexical/rich-text": "0.47.0",
    "@lexical/selection": "0.47.0",
    "@lexical/table": "0.47.0",
    "@lexical/utils": "0.47.0",
    "lexical": "0.47.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@lexical/code": "0.47.0",
    "@lexical/code-prism": "0.47.0",
    "@lexical/extension": "0.47.0",
    "@lexical/link": "0.47.0",
    "@lexical/list": "0.47.0",
    "@lexical/mdast": "0.47.0",
    "@lexical/react": "0.47.0",
    "@lexical/rich-text": "0.47.0",
    "@lexical/selection": "0.47.0",
    "@lexical/table": "0.47.0",
    "@lexical/utils": "0.47.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "jsdom": "^26.1.0",
    "lexical": "0.47.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.21.7",
    "typescript": "5.8.3",
    "vitest": "^3.2.4"
  }
}
