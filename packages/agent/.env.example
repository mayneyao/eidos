# Telegram Bot Token
# Get from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# LLM Configuration
# These will be read from eidos settings, but can be overridden here
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=your_api_key_here
# LLM_BASE_URL=https://api.openai.com/v1

# Agent Configuration
AGENT_SYSTEM_PROMPT=You are a helpful AI assistant integrated with Eidos. Be concise and friendly.

# Session timeout in minutes (default: 30)
SESSION_TIMEOUT_MINUTES=30
