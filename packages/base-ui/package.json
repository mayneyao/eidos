{
  "name": "@eidos.space/base-ui",
  "version": "0.1.0",
  "description": "Shared Eidos Base editor UI for browser and desktop hosts",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./base-data-grid": {
      "types": "./dist/base-data-grid.d.mts",
      "import": "./dist/base-data-grid.mjs",
      "default": "./dist/base-data-grid.mjs"
    },
    "./base-editor-view": {
      "types": "./dist/base-editor-view.d.mts",
