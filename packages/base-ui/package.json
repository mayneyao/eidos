  "files": [
    "dist",
    "src/styles.css"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:tsgo": "tsgo --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "eidos.space",
    "base",
    "react",
    "data-grid",
    "local-first"
