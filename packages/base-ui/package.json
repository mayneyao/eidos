    },
    "./base-gallery-view": {
      "types": "./dist/base-gallery-view.d.mts",
      "import": "./dist/base-gallery-view.mjs",
      "default": "./dist/base-gallery-view.mjs"
    },
    "./base-kanban-view": {
      "types": "./dist/base-kanban-view.d.mts",
