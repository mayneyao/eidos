{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "paths": {
      "@/lib/*": ["../lib/*"],
      "@/packages/core/*": ["../core/*"],
      "@/packages/ai/*": ["../ai/*"],
      "@/packages/shared/*": ["../shared/*"],
      "@eidos.space/lexical": ["../lexical/src/index.ts"],
      "@eidos.space/lexical/*": ["../lexical/src/*"]
    }
  },
  "include": ["./**/*.ts", "./**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
