{
  "name": "@eidos.space/plugin-sdk",
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "description": "Versioned browser SDK and offline package contract for Eidos Lite file editors",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@eidos.space/eidos-file": "workspace:*"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "prepublishOnly": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tsgo": "tsgo -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}
