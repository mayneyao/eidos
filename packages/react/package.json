{
  "name": "@eidos.space/react",
  "version": "0.27.3",
  "description": "React hooks and context for Eidos extensions",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "type": "module",
  "keywords": [
    "eidos",
    "eidos.space",
    "react",
    "hooks",
    "extensions"
  ],
  "author": "mayneyao",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mayneyao/eidos.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/mayneyao/eidos/issues"
  },
  "homepage": "https://github.com/mayneyao/eidos/tree/main/packages/react#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@eidos.space/core": "^0.28.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "tsdown": "^0.12.9",
    "typescript": "^5.8.3"
  }
}
