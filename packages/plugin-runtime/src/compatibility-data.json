{
  "hosts": {
    "eidos-lite": {
      "pluginApi": "2.0.0",
      "features": [
        "view.table",
        "view.document",
        "view.eidos",
        "view.page",
        "view.media",
        "view.file",
        "extension",
        "actions",
        "formatters",
        "connections",
        "settings",
        "storage",
        "workspace.files",
        "browser.workers",
        "browser.network",
        "theme.lite"
      ]
    },
    "eidos-cli": {
      "pluginApi": "1.0.0",
      "features": ["view.table", "browser.workers", "browser.network"]
    }
  },
  "rules": [
    { "key": "extension", "feature": "extension" },
    { "key": "actions", "feature": "actions" },
    { "key": "formatters", "feature": "formatters" },
    { "key": "connections", "feature": "connections" },
    { "key": "resources", "feature": "resources" },
    { "key": "settings", "feature": "settings" },
    { "key": "storage", "feature": "storage" },
    { "key": "workspace", "feature": "workspace.files" }
  ]
}
