{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": false,
    "lib": ["ES2022", "ESNext.Disposable", "DOM", "DOM.Iterable"],
    "outDir": "out"
  },
  "include": ["*.ts", "*.tsx"]
}
