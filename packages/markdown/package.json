{
  "name": "@eidos.space/markdown",
  "version": "0.1.0",
  "private": true,
  "description": "A composable React Markdown editor with source-aware editing and block interactions",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "./static": {
      "types": "./dist/static.d.mts",
      "import": "./dist/static.mjs",
      "default": "./dist/static.mjs"
    },
    "./static.css": "./dist/static.css",
    "./source": {
      "types": "./dist/source.d.mts",
      "import": "./dist/source.mjs",
      "default": "./dist/source.mjs"
    },
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./plugin-api": {
      "types": "./dist/plugin-api.d.mts",
      "import": "./dist/plugin-api.mjs",
      "default": "./dist/plugin-api.mjs"
    },
    "./plugins": {
      "types": "./dist/builtin-plugins.d.mts",
      "import": "./dist/builtin-plugins.mjs",
      "default": "./dist/builtin-plugins.mjs"
    },
    "./presets": {
      "types": "./dist/presets.d.mts",
      "import": "./dist/presets.mjs",
      "default": "./dist/presets.mjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "docs",
    "specs",
    "architecture",
    "API.md",
    "OBSIDIAN-COMPATIBILITY.md",
    "README.md",
    "SPEC.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsdown && tsdown --config tsdown.static.config.ts && node scripts/copy-css.mjs",
    "test": "vitest run",
    "test:static": "pnpm run build && node scripts/check-static.mjs",
    "benchmark:codec": "pnpm run build && node scripts/benchmark-codec.mjs",
    "test:package": "pnpm run build && node scripts/test-package.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:tsgo": "tsgo --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@lexical/code-core": "0.50.0",
    "@lexical/link": "0.50.0",
    "@lexical/list": "0.50.0",
    "@lexical/markdown": "0.50.0",
    "@lexical/react": "0.50.0",
    "@lexical/rich-text": "0.50.0",
    "@lexical/selection": "0.50.0",
    "@lexical/table": "0.50.0",
    "@lexical/utils": "0.50.0",
    "diff": "8.0.4",
    "hast-util-from-html": "2.0.3",
    "hast-util-raw": "9.1.0",
    "hast-util-to-html": "9.0.5",
    "katex": "0.18.5",
    "lexical": "0.50.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-gfm-autolink-literal": "2.0.1",
    "mdast-util-gfm-footnote": "2.1.0",
    "mdast-util-gfm-strikethrough": "2.0.0",
    "mdast-util-gfm-table": "2.0.0",
    "mdast-util-gfm-task-list-item": "2.0.0",
    "mdast-util-to-hast": "13.2.1",
    "micromark": "4.0.2",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-gfm-autolink-literal": "2.1.0",
    "micromark-extension-gfm-footnote": "2.1.0",
    "micromark-extension-gfm-strikethrough": "2.1.0",
    "micromark-extension-gfm-table": "2.1.1",
    "micromark-extension-gfm-tagfilter": "2.0.0",
    "micromark-extension-gfm-task-list-item": "2.1.0",
    "micromark-util-types": "2.0.2",
    "supports-color": "10.2.2",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/hast": "3.0.4",
    "@types/mdast": "4.0.4",
    "@types/react": "^18.2.14",
    "@types/react-dom": "^18.2.6",
    "jsdom": "^26.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.21.7",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}
