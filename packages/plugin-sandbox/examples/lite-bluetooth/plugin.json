{
  "apiVersion": 1,
  "id": "example.bluetooth-battery",
  "name": "Bluetooth Battery",
  "version": "1.0.0",
  "requires": { "pluginApi": "3.4.0" },
  "background": {
    "entry": "./background.ts",
    "bluetooth": {
      "services": [{ "uuid": "battery_service", "read": true, "notify": true }]
    }
  },
  "extension": "./extension.ts",
  "views": [
    {
      "id": "battery",
      "title": "Bluetooth Battery",
      "kind": "page",
      "entry": "./page.ts"
    }
  ],
  "actions": [
    {
      "id": "connect",
      "title": "Bluetooth: choose and connect battery",
      "context": "workspace"
    },
    {
      "id": "status",
      "title": "Bluetooth: battery status",
      "context": "workspace"
    },
    {
      "id": "stop",
      "title": "Bluetooth: disconnect and stop",
      "context": "workspace"
    }
  ],
  "placements": [
    { "location": "navigation", "view": "battery" },
    { "location": "command-palette", "action": "connect" },
    { "location": "command-palette", "action": "status" },
    { "location": "command-palette", "action": "stop" }
  ]
}
