{
  "apiVersion": 1,
  "id": "example.bluetooth-battery",
  "name": "Bluetooth Battery",
  "version": "1.0.0",
  "requires": { "pluginApi": "3.4.0" },
  "background": {
    "entry": "./background.ts",
    "bluetooth": true
  },
  "extension": "./extension.ts",
  "views": [
    {
      "id": "battery",
      "title": "Bluetooth Battery",
      "kind": "page",
      "entry": "./page.ts"
    }
  ],
  "actions": [
    {
      "id": "open-panel",
      "title": "蓝牙电量：打开面板",
      "context": "workspace"
    },
    {
      "id": "connect",
      "title": "蓝牙电量：选择并连接设备",
      "context": "workspace"
    },
    {
      "id": "status",
      "title": "蓝牙电量：查看连接与电量",
      "context": "workspace"
    },
    {
      "id": "stop",
      "title": "蓝牙电量：断开并停止后台",
      "context": "workspace"
    }
  ],
  "placements": [
    { "location": "navigation", "view": "battery" },
    { "location": "command-palette", "action": "open-panel" },
    { "location": "command-palette", "action": "connect" },
    { "location": "command-palette", "action": "status" },
    { "location": "command-palette", "action": "stop" }
  ]
}
