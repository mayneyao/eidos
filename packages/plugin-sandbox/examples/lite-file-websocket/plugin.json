{
  "apiVersion": 1,
  "id": "example.websocket-workbench",
  "name": "WebSocket Workbench",
  "version": "1.0.0",
  "requires": { "pluginApi": "3.4.0" },
  "background": {
    "entry": "./background.ts",
    "networkOrigins": ["ws://127.0.0.1:8787"]
  },
  "extension": "./extension.ts",
  "views": [
    {
      "id": "request",
      "title": "WebSocket Workbench",
      "kind": "file",
      "entry": "./file.ts",
      "capabilities": ["document"],
      "access": "read"
    }
  ],
  "actions": [
    {
      "id": "stop",
      "title": "WebSocket Workbench: stop shared connection",
      "context": "workspace"
    }
  ],
  "placements": [
    { "location": "file/open", "view": "request", "extensions": [".wsreq"] },
    { "location": "command-palette", "action": "stop" }
  ]
}
