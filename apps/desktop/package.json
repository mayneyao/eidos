{
  "name": "eidos",
  "version": "0.32.0",
  "description": "Eidos is an extensible framework for personal data management.",
  "main": "dist-electron/main.js",
  "start": "electron .",
  "type": "module",
  "scripts": {
    "postinstall": "electron-builder install-app-deps && node scripts/postinstall-sqlite-ext.cjs && node scripts/fix-node-pty-perms.cjs",
    "test": "echo \"Error: no test specified\" && exit 1",
    "download-libsimple": "node scripts/download-libsimple.cjs",
    "prebuild": "pnpm --filter @eidos.space/electron-ipc build && pnpm --filter @eidos.space/rawdata build && pnpm --filter @eidos.space/client build && pnpm --filter @eidos.space/ext-server run build:assets && node scripts/build-cli-local.cjs",
    "predev": "pnpm --filter @eidos.space/electron-ipc build && pnpm --filter @eidos.space/rawdata build && pnpm --filter @eidos.space/client build && pnpm --filter @eidos.space/ext-server run build:assets",
    "dev": "cross-env EIDOS_SERVICE_MODE=desktop vite --mode desktop",
    "build": "shx rm -rf dist-electron && cross-env NODE_OPTIONS=--max-old-space-size=8192 EIDOS_SERVICE_MODE=desktop vite build --mode desktop",
    "package": "cross-env BUILD_MODE=1 electron-builder --publish never --config electron/electron-builder.json",
    "package:dev": "cross-env BUILD_MODE=1 electron-builder --publish never --config electron/electron-builder.dev.json",
    "build:cli": "node scripts/build-cli-local.cjs",
    "typecheck": "tsc --noEmit",
    "typecheck:tsgo": "tsgo --noEmit"
  },
  "keywords": [],
  "author": "",
  "dependencies": {
    "@eidos.space/client": "workspace:*",
    "@eidos.space/electron-ipc": "workspace:*",
    "@eidos.space/ext-server": "workspace:*",
    "@eidos.space/proxy": "workspace:*",
    "@eidos.space/rawdata": "workspace:*",
    "@eidos.space/space-manager": "workspace:*",
    "@eidos.space/sync": "workspace:*",
    "@hono/node-server": "^1.12.2",
    "@libsql/client": "^0.8.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/wicg-file-system-access": "^2023.10.5",
    "@vscode/ripgrep": "^1.17.0",
    "ai": "^6.0.168",
    "aws-sdk": "^2.1526.0",
    "aws4fetch": "^1.0.17",
    "better-sqlite3": "^12.0.0",
    "bindings": "^1.5.0",
    "date-fns": "^2.30.0",
    "defuddle": "^0.16.0",
    "electron-log": "^5.2.0",
    "electron-updater": "^6.3.9",
    "eventemitter3": "^5.0.1",
    "file-uri-to-path": "^2.0.0",
    "hono": "^4.12.7",
    "inversify": "^8.1.0",
    "@eidos.space/just-bash": "^3.0.2",
    "linkedom": "^0.18.12",
    "native-file-system-adapter": "^3.0.1",
    "node-machine-id": "^1.1.12",
    "node-pty": "1.1.0",
    "oxc-parser": "^0.74.0",
    "oxc-transform": "^0.74.0",
    "reflect-metadata": "^0.2.2",
    "sqlite-graft": "^0.2.1",
    "sqlite-vec": "0.1.7-alpha.2",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.18.2",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.9",
    "@types/express": "^4.17.21",
    "@types/node": "^20.4.1",
    "@types/react": "^18.2.14",
    "@types/react-dom": "^18.2.6",
    "@types/react-window": "^1.8.5",
    "@types/ws": "^8.5.5",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitejs/plugin-react-oxc": "^0.2.3",
    "autoprefixer": "^10.4.14",
    "clsx": "^1.2.1",
    "cross-env": "^7.0.3",
    "electron": "^40.8.5",
    "electron-builder": "^24.13.3",
    "electron-notarize": "^1.2.2",
    "postcss": "^8.4.25",
    "prebuild-install": "^7.1.3",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.3.3",
    "vite": "^6.4.2",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-top-level-await": "^1.5.0",
    "vite-plugin-wasm": "^3.4.1"
  },
  "license": "ISC",
  "packageManager": "pnpm@10.12.4"
}
