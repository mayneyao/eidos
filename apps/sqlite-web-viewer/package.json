    "@vitejs/plugin-react": "^5.2.0",
    "better-sqlite3": "^12.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^8.1.5",
    "vite-plugin-top-level-await": "^1.6.0",
