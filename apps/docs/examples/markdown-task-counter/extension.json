{
  "$schema": "../../public/schemas/extension-manifest.schema.json",
  "manifestVersion": 1,
  "publisher": "example",
  "name": "markdown-task-counter",
  "displayName": "Markdown Task Counter",
  "description": "Count open and completed tasks in a Markdown file.",
  "version": "0.1.0",
  "engines": {
    "eidos": ">=0.34.0"
  },
  "entrypoints": {
    "worker": "src/extension.ts"
  },
  "contributes": {
    "commands": [
      {
        "id": "example.markdown-task-counter.countTasks",
        "title": "Count Markdown tasks"
      }
    ],
    "menus": {
      "files/context": [
        {
          "command": "example.markdown-task-counter.countTasks",
          "when": "resourceExtname == .md"
        }
      ]
    }
  },
  "permissions": {
    "files": {
      "read": ["**/*.md"],
      "write": []
    },
    "network": []
  }
}
