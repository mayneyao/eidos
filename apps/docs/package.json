{
  "name": "docs",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync:specs": "node ./scripts/sync-specs.mjs",
    "check:content": "pnpm run sync:specs && node ./scripts/check-content.mjs",
    "dev": "pnpm run sync:specs && astro dev",
    "start": "pnpm run dev",
    "build": "pnpm run check:content && astro build && node ./scripts/check-build.mjs",
    "preview": "astro preview",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler deploy --env preview",
    "astro": "astro",
    "typecheck": "pnpm run check:content && astro check",
    "typecheck:tsgo": "echo 'skip'"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/starlight": "0.42.0",
    "astro": "7.3.2",
    "sharp": "^0.35.4",
    "starlight-sidebar-topics": "0.9.0",
    "starlight-theme-flexoki": "^0.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "5.8.3",
    "wrangler": "4.102.0"
  }
}
