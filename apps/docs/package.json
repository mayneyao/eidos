{
  "name": "docs",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "precheck:examples": "pnpm --filter @eidos.space/extension-cli build",
    "check:examples": "node scripts/check-examples.mjs",
    "build": "pnpm run check:examples && astro build",
    "preview": "astro preview",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler deploy --env preview",
    "astro": "astro",
    "typecheck": "astro sync && tsc --noEmit",
    "typecheck:tsgo": "echo 'skip'"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/starlight": "0.40.0",
    "astro": "6.4.6",
    "sharp": "^0.34.2",
    "starlight-sidebar-topics": "0.8.0",
    "starlight-theme-flexoki": "^0.1.0"
  },
  "devDependencies": {
    "@eidos.space/extension-cli": "workspace:*",
    "ajv": "^8.20.0",
    "wrangler": "4.102.0"
  }
}
