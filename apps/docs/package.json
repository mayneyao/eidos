  },
  "dependencies": {
    "@astrojs/sitemap": "^3.4.1",
    "@astrojs/starlight": "0.37.7",
    "astro": "^5.15.9",
    "sharp": "^0.34.2",
    "starlight-sidebar-topics": "^0.6.2",
    "starlight-theme-flexoki": "^0.1.0"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "wrangler": ">=4.14.1"
  }
}
