{
  "name": "docs",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "check:examples": "node scripts/check-examples.mjs",
    "build": "pnpm run check:examples && astro build",
