{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.eidos.space/schemas/extension-manifest.schema.json",
  "$comment": "Design preview for the file-based Eidos extension runtime.",
  "title": "Eidos Extension Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "publisher",
    "name",
    "displayName",
    "version",
    "engines",
    "entrypoints",
    "contributes",
    "permissions"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "manifestVersion": {
      "const": 1
    },
    "publisher": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 240
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eidos"],
      "properties": {
        "eidos": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "worker": { "$ref": "#/$defs/relativePath" },
        "ui": { "$ref": "#/$defs/relativePath" }
      }
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "array",
          "items": { "$ref": "#/$defs/command" }
        },
        "menus": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/$defs/menuItem" }
          },
          "propertyNames": {
            "enum": [
              "files/context",
              "document/context",
              "base/context",
              "base/row/context"
            ]
          }
        },
        "fileEditors": {
          "type": "array",
          "items": { "$ref": "#/$defs/fileEditor" }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "network"],
      "properties": {
        "files": {
          "type": "object",
          "additionalProperties": false,
          "required": ["read", "write"],
          "properties": {
            "read": { "$ref": "#/$defs/uniqueStrings" },
            "write": { "$ref": "#/$defs/uniqueStrings" }
          }
        },
        "network": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^https://[^/]+$"
          }
        }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.(?:ts|tsx|js|jsx)$"
    },
    "uniqueStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "category": {
          "type": "string",
          "maxLength": 40
        }
      }
    },
    "menuItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": { "$ref": "#/$defs/identifier" },
        "when": {
          "type": "string",
          "maxLength": 240
        },
        "group": {
          "type": "string",
          "maxLength": 40
        }
      }
    },
    "fileEditor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "selector", "priority", "component"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "selector": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "filenamePattern": { "type": "string", "minLength": 1 },
              "mediaType": { "type": "string", "minLength": 1 }
            }
          }
        },
        "priority": {
          "enum": ["default", "option"]
        },
        "component": { "$ref": "#/$defs/identifier" }
      }
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*){2,}$"
    }
  }
}
