+pub struct PreparedFetch<'a> {
+    repository: &'a Repository,
+    remote: Remote,
+    outcome: FetchOutcome,
+    payload_bytes: u64,
+}
+
+impl PreparedFetch<'_> {
+    pub fn head(&self) -> &str {
+        &self.outcome.head
+    }
