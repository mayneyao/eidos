+    pub fn prepare_fetch(&self, remote: &str, branch: &str) -> Result<PreparedFetch<'_>> {
+        validate_remote_name(remote)?;
+        validate_ref_name(branch)?;
+        ACTIVE_TRANSFER_PROGRESS.with(|active| {
+            if let Some(reporter) = active.borrow().as_ref() {
