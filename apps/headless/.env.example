# Example environment configuration for Eidos Headless Server
# Copy this file to .env and fill in your values

# S3 credentials (required for Graft sync)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_ENDPOINT=https://s3.eidos.space
AWS_REGION=auto

# Graft storage location
S3_BUCKET_NAME=eidos-sync
S3_PREFIX=spaceName/.eidos/.graft
S3_FILES_PREFIX=spaceName/.eidos/.files
# Remote Log ID (required for clone-from-remote)
# Get this from your existing Eidos space's graft logs
# Example: 01JD6ABCD1234567890ABCDEF
REMOTE_LOG_ID=

# Server configuration
PORT=3000
HOST=0.0.0.0

# Data directory
DATA_DIR=./data

# API Key for authentication (Optional, but recommended)
# If set, requests to /rpc and /graft/* must include "Authorization: Bearer your-api-key"
API_KEY=

# SQLite extensions directory (auto-detected if not set)
# SQLITE_EXTENSIONS_DIR=./dist-sqlite-ext

