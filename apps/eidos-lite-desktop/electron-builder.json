{
  "appId": "space.eidos.lite",
  "productName": "Eidos Lite",
  "directories": {
    "output": "dist-app"
  },
  "npmRebuild": false,
  "electronLanguages": ["en", "zh", "pt", "ja", "ko"],
  "files": [
    "dist/**/*",
    "package.json",
    "!**/node_modules/**/*",
    "**/node_modules/@eidos.space/graft/**/*",
    "**/node_modules/@eidos.space/eidos-file/dist/**/*",
    "!**/node_modules/@eidos.space/eidos-file/dist/**/*.map",
    "**/node_modules/@eidos.space/eidos-file/{package.json,LICENSE*}",
    "**/node_modules/csv-parse/{package.json,LICENSE*,lib/**/*.js,dist/cjs/*.cjs,dist/esm/sync.js}",
    "**/node_modules/moment/{package.json,LICENSE*,moment.js}",
    "**/node_modules/moment-timezone/{package.json,LICENSE*,index.js,moment-timezone.js,data/packed/latest.json}",
    "**/node_modules/@eidos.space/graft-*/**/*",
    "**/node_modules/koffi/**/*",
    "**/node_modules/@koromix/koffi-*/**/*",
    "**/node_modules/node-pty/{package.json,LICENSE*,deps/winpty/LICENSE,lib/**/*.js,build/{Release,Debug}/**/*,prebuilds/**/*}",
    "!**/node_modules/node-pty/lib/**/*.test.js",
    "**/node_modules/esbuild/{package.json,LICENSE*,lib/main.js}",
    "**/node_modules/@esbuild/**/*",
    "**/node_modules/typescript/{package.json,LICENSE*,ThirdPartyNoticeText.txt,lib/typescript.js}",
    "**/node_modules/selfsigned/**/*",
    "**/node_modules/node-forge/**/*",
    "!dist-app{,/**/*}"
  ],
  "asarUnpack": [
    "**/node_modules/typescript/**/*",
    "**/node_modules/esbuild/**/*",
    "**/node_modules/@esbuild/**/*",
    "**/node_modules/@eidos.space/graft-*/**/*",
    "**/node_modules/@koromix/koffi-*/**/*",
    "**/node_modules/node-pty/**/*"
  ],
  "extraResources": [
    {
      "from": "resources/plugin-sandbox",
      "to": "plugin-sandbox",
      "filter": ["plugin-sandbox", "plugin-sandbox.exe"]
    },
    {
      "from": "node_modules/typescript/lib",
      "to": "app.asar.unpacked/node_modules/typescript/lib",
      "filter": ["lib*.d.ts"]
    },
    {
      "from": "resources/publish-engine",
      "to": "publish-engine",
      "filter": ["**/*"]
    },
    {
      "from": "resources/vtab",
      "to": "vtab",
      "filter": ["**/*"]
    }
  ],
  "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
  "artifactBuildCompleted": "./scripts/finalize-macos-dmg.mjs",
  "publish": {
    "provider": "generic",
    "url": "https://download.eidos.space/lite/updates/stable",
    "channel": "latest"
  },
  "fileAssociations": [
    {
      "ext": "eidos",
      "name": "Eidos File",
      "description": "Eidos local database file",
      "role": "Editor"
    },
    {
      "ext": "eidos-plugin",
      "name": "Eidos Plugin",
      "description": "Eidos plugin installation package",
      "role": "Viewer",
      "mimeType": "application/x-eidos-plugin"
    }
  ],
  "protocols": [
    {
      "name": "Eidos Lite plugin installation",
      "schemes": ["eidos-lite"]
    }
  ],
  "mac": {
    "files": [
      {
        "filter": [
          "dist-electron/**/*",
          "!**/node_modules/@esbuild/!(darwin-${arch}){,/**/*}",
          "!**/node_modules/node-pty/prebuilds/!(darwin-${arch}){,/**/*}"
        ]
      }
    ],
    "target": ["dmg", "zip"],
    "icon": "assets/logo.icns",
    "forceCodeSigning": true,
    "hardenedRuntime": true,
    "extendInfo": {
      "NSBluetoothAlwaysUsageDescription": "Allow Eidos Lite to discover and connect to BLE devices that you explicitly grant to plugins.",
      "NSBluetoothPeripheralUsageDescription": "Allow Eidos Lite to connect to BLE devices selected for plugins."
    },
    "gatekeeperAssess": false,
    "notarize": true,
    "extraResources": [
      {
        "from": "resources/file-clipboard",
        "to": "file-clipboard",
        "filter": ["eidos-file-clipboard"]
      }
    ]
  },
  "dmg": {
    "writeUpdateInfo": false
  },
  "win": {
    "files": [
      {
        "filter": [
          "dist-electron/**/*",
          "!**/node_modules/@esbuild/!(win32-${arch}){,/**/*}",
          "!**/node_modules/node-pty/prebuilds/!(win32-${arch}){,/**/*}",
          "!**/node_modules/node-pty/build{,/**/*}"
        ]
      }
    ],
    "target": ["nsis"],
    "icon": "assets/logo.ico",
    "forceCodeSigning": false
  },
  "linux": {
    "files": [
      {
        "filter": [
          "dist-electron/**/*",
          "!**/node_modules/@esbuild/!(linux-${arch}){,/**/*}",
          "!**/node_modules/node-pty/prebuilds/!(linux-${arch}){,/**/*}"
        ]
      }
    ],
    "target": ["AppImage", "deb"],
    "icon": "assets/icons",
    "executableName": "eidos-lite-desktop",
    "category": "Utility",
    "synopsis": "Local-first desktop editor for Eidos File Spaces",
    "maintainer": "Mayne <i@gine.me>"
  },
  "deb": {
    "packageName": "eidos-lite",
    "packageCategory": "utils",
    "priority": "optional"
  }
}
