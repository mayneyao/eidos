{
  "appId": "space.eidos.lite",
  "productName": "Eidos Lite",
  "directories": {
    "output": "dist-app"
  },
  "npmRebuild": false,
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json",
    "!**/node_modules/**/*",
    "**/node_modules/@eidos.space/graft/**/*",
    "**/node_modules/@eidos.space/graft-*/**/*"
  ],
  "asarUnpack": ["**/node_modules/@eidos.space/graft-*/**/*"],
  "extraResources": [
    {
      "from": "resources/publish-engine",
      "to": "publish-engine",
      "filter": ["**/*"]
    }
  ],
  "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
  "publish": {
    "provider": "generic",
    "url": "https://download.eidos.space/lite/updates/stable",
    "channel": "latest"
  },
  "fileAssociations": [
    {
      "ext": "eidos",
      "name": "Eidos File",
      "description": "Eidos local database file",
      "role": "Editor"
    }
  ],
  "mac": {
    "target": ["dmg", "zip"],
    "icon": "assets/logo.icns",
    "forceCodeSigning": true,
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "notarize": true
  },
  "win": {
    "target": ["nsis"],
    "icon": "assets/logo.ico",
    "forceCodeSigning": false
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "icon": "assets/icons",
    "executableName": "eidos-lite-desktop",
    "category": "Utility",
    "synopsis": "Local-first desktop editor for Eidos File Spaces",
    "maintainer": "Mayne <i@gine.me>"
  },
  "deb": {
    "packageName": "eidos-lite",
    "packageCategory": "utils",
    "priority": "optional"
  }
}
