{
  "appId": "space.eidos.lite",
  "productName": "Eidos Lite",
  "directories": {
    "output": "dist-app"
  },
  "npmRebuild": false,
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json",
    "!**/node_modules/**/*",
    "**/node_modules/@eidos.space/graft/**/*",
    "**/node_modules/@eidos.space/graft-*/**/*"
  ],
  "asarUnpack": ["**/node_modules/@eidos.space/graft-*/**/*"],
  "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
  "fileAssociations": [
    {
      "ext": "eidos",
      "name": "Eidos File",
      "description": "Eidos local database file",
      "role": "Editor"
    }
  ],
  "mac": {
    "target": ["dmg", "zip"],
    "icon": "../web-app/public/logo.icns",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "notarize": false
  },
  "win": {
    "target": ["nsis"],
    "icon": "../web-app/public/logo.ico"
  },
  "linux": {
    "target": ["AppImage"],
    "icon": "../web-app/public/logo.png"
  }
}
